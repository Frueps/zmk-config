#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "zmk-helpers/key-labels/42.h"

#define KEYS_L    LT0 LT1 LT2 LT3 LT4 LT5  LM0 LM1 LM2 LM3 LM4 LM5  LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R    RT0 RT1 RT2 RT3 RT4 RT5  RM0 RM1 RM2 RM3 RM4 RM5  RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS_L  LH2 LH1 LH0
#define THUMBS_R  RH0 RH1 RH2

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <320>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS_R>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <320>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L>;
            hold-trigger-on-release;
        };
    };
};

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer { // layer 0
                    display-name = "Zero";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q         &kp W        &kp F        &kp P         &kp B      &kp J      &kp L         &kp U        &kp Y        &kp SEMI      &kp BSPC
   &kp ESC   &hml LCTRL A  &hml LALT R  &hml LGUI S  &hml LSHFT T  &kp G      &kp M      &hmr RSHFT N  &hmr RGUI E  &hmr RALT I  &hmr RCTRL O  &kp EQUAL
   &none     &kp Z         &kp X        &kp C        &kp D         &kp V      &kp K      &kp H         &kp COMMA    &kp DOT      &kp FSLH      &kp DEL
                                        &none        &mo 1         &kp RET    &kp SPACE  &mo 2         &none
                        >;
                };
                lower_layer { // layer 1
                    display-name = "One";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &none  &none           &none         &none         &none  &none    &none  &none  &none  &none  &none  &none
   &none  &none           &none         &none         &none  &none    &none  &none  &none  &none  &none  &none
   &none  &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &none  &none    &none  &none  &none  &none  &none  &none
                                        &none         &none  &none    &none  &none  &none
                        >;
                };

                raise_layer { // layer 2
                    display-name = "Two";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &none  &none           &none         &none         &none  &none    &none  &none  &none  &none  &none  &none
   &none  &none           &none         &none         &none  &none    &none  &none  &none  &none  &none  &none
   &none  &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &none  &none    &none  &none  &none  &none  &none  &none
                                        &none         &none  &none    &none  &none  &none
                        >;
                };
        };
};
